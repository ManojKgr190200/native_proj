{
  "name": "native_proj",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "android:dev": "ENVFILE=.env.dev react-native run-android --mode=developmentDebug --appIdSuffix=dev",
    "android:staging": "ENVFILE=.env.staging react-native run-android --mode=stagingDebug --appIdSuffix=staging",
    "android:prod": "ENVFILE=.env.production react-native run-android --mode=productionRelease",
    "build:android:dev": "cd android && ENVFILE=../.env.dev ./gradlew assembleDevelopmentDebug",
    "build:android:staging": "cd android && ENVFILE=../.env.staging ./gradlew assembleStagingRelease",
    "build:android:prod": "cd android && ENVFILE=../.env.production ./gradlew assembleProductionRelease",
    "bundle:android:prod": "cd android && ENVFILE=../.env.production ./gradlew bundleProductionRelease",
    "ios:dev": "ENVFILE=.env.dev react-native run-ios --scheme native_proj-dev --mode DebugDev",
    "ios:staging": "ENVFILE=.env.staging react-native run-ios --scheme native_proj-staging --mode DebugStaging",
    "ios:prod": "ENVFILE=.env.production react-native run-ios --scheme native_proj --mode ReleaseProd",
    "ios:prod:debug": "ENVFILE=.env.production react-native run-ios --scheme native_proj --mode DebugProd",
    "build:ios:dev": "ENVFILE=.env.dev xcodebuild -workspace ios/native_proj.xcworkspace -scheme native_proj-dev -configuration ReleaseDev",
    "build:ios:staging": "ENVFILE=.env.staging xcodebuild -workspace ios/native_proj.xcworkspace -scheme native_proj-staging -configuration ReleaseStaging",
    "build:ios:prod": "ENVFILE=.env.production xcodebuild -workspace ios/native_proj.xcworkspace -scheme native_proj -configuration ReleaseProd"
  },
  "dependencies": {
    "@op-engineering/op-sqlite": "^18.2.4",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native/new-app-screen": "0.87.1",
    "@reduxjs/toolkit": "^2.12.0",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-config": "^1.7.2",
    "react-native-keychain": "^10.0.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-uuid": "^2.0.4",
    "react-redux": "^9.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
